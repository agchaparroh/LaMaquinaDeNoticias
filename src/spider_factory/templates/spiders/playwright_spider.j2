class {{ medio|title|replace(' ', '') }}{{ seccion|title|replace(' ', '') }}Spider(scrapy.Spider):
    """
    Spider Playwright para {{ medio }} - {{ seccion }}
    
    Utiliza Playwright para renderizar JavaScript y extraer contenido dinámico.
    Área geográfica: {{ area_geografica }}
    Tipo de medio: {{ tipo_medio }}
    """
    name = "{{ medio|lower|replace(' ', '_') }}_{{ seccion|lower|replace(' ', '_') }}"
    allowed_domains = ["{{ domain }}"]
    start_urls = ["{{ base_url }}"]
    
    # Configuración
    custom_settings = {
        'USER_AGENT': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
        'ROBOTSTXT_OBEY': True,
        'CONCURRENT_REQUESTS': 1,  # Playwright es más pesado, reducir concurrencia
        'DOWNLOAD_DELAY': 3,
        'COOKIES_ENABLED': True,
        
        # Scrapy-crawl-once configuration
        'CRAWL_ONCE_ENABLED': True,
        'CRAWL_ONCE_PATH': f'.scrapy/crawl_once/{{ medio|lower|replace(" ", "_") }}_{{ seccion|lower|replace(" ", "_") }}',
        'CRAWL_ONCE_DEFAULT': False,
        
        # Configuración de Playwright
        'DOWNLOAD_HANDLERS': {
            "http": "scrapy_playwright.handler.ScrapyPlaywrightDownloadHandler",
            "https": "scrapy_playwright.handler.ScrapyPlaywrightDownloadHandler",
        },
        'TWISTED_REACTOR': "twisted.internet.asyncioreactor.AsyncioSelectorReactor",
        'PLAYWRIGHT_BROWSER_TYPE': 'chromium',
