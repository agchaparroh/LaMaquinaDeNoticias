class {{ medio|title|replace(' ', '') }}{{ seccion|title|replace(' ', '') }}Spider(CrawlSpider):
    """
    Spider de scraping para {{ medio }} - {{ seccion }}
    
    Utiliza scraping tradicional con reglas de crawling.
    Área geográfica: {{ area_geografica }}
    Tipo de medio: {{ tipo_medio }}
    """
    name = "{{ medio|lower|replace(' ', '_') }}_{{ seccion|lower|replace(' ', '_') }}"
    allowed_domains = ["{{ domain }}"]
    start_urls = ["{{ base_url }}"]
    
    # Configuración
    custom_settings = {
        'USER_AGENT': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
        'ROBOTSTXT_OBEY': True,
        'CONCURRENT_REQUESTS': 2,
        'DOWNLOAD_DELAY': 2,
        'COOKIES_ENABLED': True,
        'AUTOTHROTTLE_ENABLED': True,
        'AUTOTHROTTLE_TARGET_CONCURRENCY': 2.0,
        
        # Scrapy-crawl-once configuration
        'CRAWL_ONCE_ENABLED': True,
        'CRAWL_ONCE_PATH': f'.scrapy/crawl_once/{{ medio|lower|replace(" ", "_") }}_{{ seccion|lower|replace(" ", "_") }}',
        'CRAWL_ONCE_DEFAULT': False,
        
        # Configuración de encoding
        'FEED_EXPORT_ENCODING': 'utf-8',
        
        # SCRAPYD CONFIGURATION:
        # Schedule: Every {{ frecuencia_minutos }} minutes
        # Project: lamaquina
        # Spider: {{ medio|lower|replace(" ", "_") }}_{{ seccion|lower|replace(" ", "_") }}
        # Arguments: -a max_items=100
    }
    
    # Reglas de crawling
    rules = (
        {% if url_patterns %}
        # Patrones de URL detectados
        {% for pattern in url_patterns %}
        Rule(
            LinkExtractor(
                allow=r'{{ pattern.regex }}',
                {% if pattern.deny %}deny=r'{{ pattern.deny }}',{% endif %}
                restrict_css='{{ pattern.restrict_css|default("") }}'
            ),
            callback='parse_article',
            follow={{ pattern.follow|default('True') }}
        ),
        {% endfor %}
        {% else %}
        # Reglas genéricas para sitios de noticias
        Rule(
            LinkExtractor(
                allow=(
                    r'/{{ seccion|lower|replace(" ", "[-_]?") }}/',  # URLs de la sección
                    r'/\d{4}/\d{2}/\d{2}/',  # Formato fecha: /2024/03/15/
                    r'/article/',
                    r'/news/',
                    r'/story/',
                ),
                deny=(
                    r'/archivo/', r'/hemeroteca/', r'/newsletter/',
                    r'/multimedia/', r'/video/', r'/podcast/',
                    r'/tags?/', r'/autor/', r'/busca[rd]?/',
                    r'/categoria/', r'/category/',
                    r'/search', r'/login', r'/register',
                    r'\?',  # Evitar URLs con parámetros
                )
            ),
            callback='parse_article',
            follow=True
        ),
        {% endif %}
        
        # Regla para seguir paginación
        Rule(
            LinkExtractor(
                allow=(r'/page/\d+', r'\?page=\d+', r'/pagina/\d+'),
                restrict_css='.pagination, .pager, nav[aria-label="pagination"]'
            ),
            follow=True
        ),
    )
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.articles_scraped = 0
        self.max_articles = int(kwargs.get('max_items', 100))
        
        # Información del medio
        self.medio_info = {
            'medio': "{{ medio }}",
            'seccion': "{{ seccion }}",
            'area_geografica': "{{ area_geografica }}",
            'tipo_medio': "{{ tipo_medio }}",
            'medio_url_principal': "{{ base_url }}",
            'frecuencia_minutos': {{ frecuencia_minutos }},
        }
    
    @classmethod
    def from_crawler(cls, crawler, *args, **kwargs):
        spider = super().from_crawler(crawler, *args, **kwargs)
        crawler.signals.connect(spider.spider_closed, signal=signals.spider_closed)
        return spider
    
    def parse_start_url(self, response):
        """Parsea la página principal"""
        self.logger.info(f"Parseando página principal: {response.url}")
        
        # Extraer enlaces a artículos desde la página principal
        article_links = self.extract_article_links(response)
        
        for link in article_links[:self.max_articles]:
            yield response.follow(link, callback=self.parse_article)
    
    def extract_article_links(self, response) -> List[str]:
        """Extrae enlaces a artículos de una página"""
        links = []
        
        # Selectores comunes para enlaces de artículos
        link_selectors = [
            'article a::attr(href)',
            '.post a::attr(href)',
            '.story a::attr(href)',
            '.headline a::attr(href)',
            'h2 a::attr(href)',
            'h3 a::attr(href)',
        ]
        
        for selector in link_selectors:
            links.extend(response.css(selector).getall())
        
        # Filtrar y validar enlaces
        valid_links = []
        for link in links:
            if self._is_section_article(link):
                valid_links.append(link)
        
        return list(set(valid_links))  # Eliminar duplicados
    
    def _is_section_article(self, url: str) -> bool:
        """Valida si la URL pertenece a la sección objetivo"""
        excluded_patterns = [
            r'/archivo/', r'/hemeroteca/', r'/newsletter/',
            r'/multimedia/', r'/video/', r'/podcast/',
            r'/tags?/', r'/autor/', r'/busca[rd]?/',
        ]
        
        for pattern in excluded_patterns:
            if re.search(pattern, url, re.IGNORECASE):
                return False
        
        # Verificar que pertenece a la sección
        section_pattern = re.compile(r'/{{ seccion|lower|replace(" ", "[-_]?") }}/', re.IGNORECASE)
        if section_pattern.search(url):
            return True
            
        # Verificar otros indicadores de artículo
        article_patterns = [
            r'/\d{4}/\d{2}/\d{2}/',  # Fecha en URL
            r'/article/',
            r'/news/',
            r'/story/',
            r'-\d{5,}',  # ID numérico
        ]
        
        for pattern in article_patterns:
            if re.search(pattern, url):
                return True
        
        return False
    
    def parse_article(self, response):
        """Parsea una página de artículo"""
        if response.status != 200:
            self.logger.warning(f"Error accediendo artículo: {response.status} - {response.url}")
            return
        
        # Verificar si realmente es un artículo
        if not self.is_article_page(response):
            self.logger.debug(f"No es un artículo: {response.url}")
            return
        
        # Crear item con campos obligatorios
        article_data = {
            # Campos obligatorios
            'url': response.url,
            'medio': self.medio_info['medio'],
            'medio_url_principal': self.medio_info['medio_url_principal'],
            'area_geografica': self.medio_info['area_geografica'],
            'tipo_medio': self.medio_info['tipo_medio'],
            'seccion': self.medio_info['seccion'],
            'fuente': self.name,
            'fecha_recopilacion': datetime.now().isoformat(),
            
            # Metadata
            'metadata': {
                'spider_type': 'scraping',
                'extraction_method': 'css_selectors',
                'http_status': response.status,
            }
        }
        
        try:
            # Extraer datos usando selectores
            {% if selectors %}
            # Selectores específicos del sitio
            {% if selectors.title %}
            title = response.css('{{ selectors.title }}::text').get()
            if title:
                article_data['titular'] = title.strip()
            {% endif %}
            
            {% if selectors.content %}
            content_elements = response.css('{{ selectors.content }}')
            if content_elements:
                # Extraer texto
                text_content = ' '.join(content_elements.css('::text').getall())
                article_data['contenido_texto'] = text_content.strip()
                
                # Extraer HTML
                html_content = ''.join(content_elements.extract())
                article_data['contenido_html'] = html_content
            {% endif %}
            
            {% if selectors.author %}
            author = response.css('{{ selectors.author }}::text').get()
            if author:
                article_data['autor'] = author.strip()
            {% endif %}
            
            {% if selectors.date %}
            date_str = response.css('{{ selectors.date }}::attr(datetime)').get() or \
                      response.css('{{ selectors.date }}::text').get()
            if date_str:
                fecha = self.parse_date(date_str.strip())
                if fecha:
                    article_data['fecha_publicacion'] = fecha
            {% endif %}
            
            {% if selectors.categories %}
            categories = response.css('{{ selectors.categories }}::text').getall()
            if categories:
                article_data['metadata']['categorias'] = [cat.strip() for cat in categories]
            {% endif %}
            
            {% if selectors.tags %}
            tags = response.css('{{ selectors.tags }}::text').getall()
            if tags:
                article_data['metadata']['tags'] = [tag.strip() for tag in tags]
            {% endif %}
            
            {% if selectors.image %}
            image = response.css('{{ selectors.image }}::attr(src)').get()
            if image:
                article_data['imagen_principal'] = response.urljoin(image)
            {% endif %}
            {% else %}
            # Extracción genérica si no hay selectores específicos
            self.extract_generic_article(response, article_data)
            {% endif %}
            
            # Extraer metadata adicional
            self.extract_metadata(response, article_data)
            
            # Intentar extraer fecha si no se encontró
            if 'fecha_publicacion' not in article_data:
                fecha = self._extract_date(response)
                if fecha:
                    article_data['fecha_publicacion'] = fecha.isoformat()
            
            # Validar que tenemos contenido mínimo
            if not article_data.get('titular') or not article_data.get('contenido_texto'):
                self.logger.warning(f"Artículo sin título o contenido: {response.url}")
                return
            
            # Limpiar y normalizar datos
            article_data = self.clean_article_data(article_data)
            
        except Exception as e:
            self.logger.error(f"Error extrayendo contenido de {response.url}: {e}")
            return
        
        self.articles_scraped += 1
        self.logger.info(f"Artículo {self.articles_scraped} extraído: {article_data.get('titular', 'Sin título')}")
        
        yield article_data
        
        # Limitar número de artículos
        if self.articles_scraped >= self.max_articles:
            self.logger.info(f"Alcanzado límite de {self.max_articles} artículos")
            self.crawler.engine.close_spider(self, 'max_articles_reached')
    
    def is_article_page(self, response) -> bool:
        """Verifica si la página actual es un artículo"""
        # Verificar por schema.org
        if response.css('script[type="application/ld+json"]').re(r'"@type":\s*"NewsArticle"'):
            return True
        
        # Verificar por meta tags
        if response.css('meta[property="og:type"]::attr(content)').get() == 'article':
            return True
        
        # Verificar por estructura HTML
        article_indicators = [
            'article',
            '[itemtype*="Article"]',
            '.post-content',
            '.article-content',
            '.story-body'
        ]
        
        for indicator in article_indicators:
            if response.css(indicator):
                return True
        
        return False
    
    def extract_generic_article(self, response, article_data: Dict[str, Any]):
        """Extracción genérica cuando no hay selectores específicos"""
        # Título
        title_selectors = [
            'h1::text',
            'meta[property="og:title"]::attr(content)',
            'title::text'
        ]
        for selector in title_selectors:
            title = response.css(selector).get()
            if title and 'titular' not in article_data:
                article_data['titular'] = title.strip()
                break
        
        # Contenido
        content_selectors = [
            'article',
            '[itemprop="articleBody"]',
            '.post-content',
            '.article-content',
            '.entry-content',
            'main'
        ]
        for selector in content_selectors:
            content = response.css(f'{selector} ::text').getall()
            if content:
                text_content = ' '.join(p.strip() for p in content if p.strip())
                if text_content and 'contenido_texto' not in article_data:
                    article_data['contenido_texto'] = text_content
                    # También obtener HTML
                    html_content = response.css(selector).get()
                    if html_content:
                        article_data['contenido_html'] = html_content
                    break
        
        # Autor
        author_selectors = [
            '[rel="author"]::text',
            '[itemprop="author"]::text',
            '.author-name::text',
            '.by-author::text',
            '.article-author::text'
        ]
        for selector in author_selectors:
            author = response.css(selector).get()
            if author and 'autor' not in article_data:
                article_data['autor'] = author.strip()
                break
        
        # Imagen principal
        if 'imagen_principal' not in article_data:
            image_selectors = [
                'meta[property="og:image"]::attr(content)',
                '[itemprop="image"]::attr(src)',
                'article img::attr(src)',
                '.featured-image img::attr(src)'
            ]
            for selector in image_selectors:
                image = response.css(selector).get()
                if image:
                    article_data['imagen_principal'] = response.urljoin(image)
                    break
    
    def _extract_date(self, response) -> Optional[datetime]:
        """Intenta extraer la fecha de publicación del artículo"""
        # Buscar en meta tags comunes
        date_selectors = [
            'meta[property="article:published_time"]::attr(content)',
            'meta[name="publish_date"]::attr(content)',
            'meta[name="DC.date.issued"]::attr(content)',
            'time[datetime]::attr(datetime)',
            'time[pubdate]::attr(datetime)',
            '[itemprop="datePublished"]::attr(content)',
        ]
        
        for selector in date_selectors:
            date_str = response.css(selector).get()
            if date_str:
                try:
                    # Intentar parsear ISO format
                    return datetime.fromisoformat(date_str.replace('Z', '+00:00'))
                except:
                    try:
                        # Intentar otros formatos comunes
                        return datetime.strptime(date_str[:19], '%Y-%m-%dT%H:%M:%S')
                    except:
                        pass
        
        return None
    
    def extract_metadata(self, response, article_data: Dict[str, Any]):
        """Extrae metadata adicional de la página"""
        # Open Graph
        og_fields = ['title', 'description', 'image', 'type', 'url', 'site_name']
        for field in og_fields:
            value = response.css(f'meta[property="og:{field}"]::attr(content)').get()
            if value:
                article_data['metadata'][f'og_{field}'] = value
        
        # Si no hay imagen principal, usar og:image
        if 'imagen_principal' not in article_data and 'og_image' in article_data['metadata']:
            article_data['imagen_principal'] = article_data['metadata']['og_image']
        
        # Schema.org/JSON-LD
        json_ld = response.css('script[type="application/ld+json"]::text').getall()
        if json_ld:
            article_data['metadata']['structured_data'] = json_ld
    
    def parse_date(self, date_string: str) -> Optional[str]:
        """Intenta parsear una fecha a formato ISO"""
        if not date_string:
            return None
        
        # Si ya está en formato ISO, devolverla
        if re.match(r'\d{4}-\d{2}-\d{2}', date_string):
            return date_string
        
        # Intentar parsear formatos comunes
        try:
            # Import dateutil solo si está disponible
            from dateutil import parser
            parsed_date = parser.parse(date_string)
            return parsed_date.isoformat()
        except:
            # Intentar formatos manuales comunes
            date_formats = [
                '%Y-%m-%d %H:%M:%S',
                '%d/%m/%Y',
                '%d-%m-%Y',
                '%Y/%m/%d',
                '%B %d, %Y',
                '%b %d, %Y',
                '%d de %B de %Y',
            ]
            
            for fmt in date_formats:
                try:
                    parsed_date = datetime.strptime(date_string, fmt)
                    return parsed_date.isoformat()
                except:
                    continue
            
            self.logger.warning(f"No se pudo parsear fecha: {date_string}")
            return None
    
    def clean_article_data(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """Limpia y normaliza los datos del artículo"""
        # Limpiar espacios en blanco excesivos
        if 'contenido_texto' in data:
            data['contenido_texto'] = re.sub(r'\s+', ' ', data['contenido_texto']).strip()
            # Eliminar contenido muy corto (probablemente no es el artículo real)
            if len(data['contenido_texto']) < 100:
                self.logger.warning(f"Contenido muy corto ({len(data['contenido_texto'])} chars)")
        
        if 'titular' in data:
            data['titular'] = re.sub(r'\s+', ' ', data['titular']).strip()
        
        # Eliminar campos vacíos
        cleaned_data = {}
        for k, v in data.items():
            if v:
                if k == 'metadata' and isinstance(v, dict):
                    # Limpiar metadata recursivamente
                    cleaned_metadata = {mk: mv for mk, mv in v.items() if mv}
                    if cleaned_metadata:
                        cleaned_data[k] = cleaned_metadata
                else:
                    cleaned_data[k] = v
        
        return cleaned_data
    
    def spider_closed(self, spider):
        """Llamado cuando el spider termina"""
        stats = spider.crawler.stats.get_stats()
        
        self.logger.info(f"""
        ========== RESUMEN DE SCRAPING ==========
        Spider: {spider.name}
        Medio: {self.medio_info['medio']}
        Sección: {self.medio_info['seccion']}
        Artículos extraídos: {self.articles_scraped}
        Páginas visitadas: {stats.get('downloader/request_count', 0)}
        Duración: {stats.get('elapsed_time_seconds', 0):.2f} segundos
        Velocidad: {stats.get('item_scraped_count', 0) / max(stats.get('elapsed_time_seconds', 1), 1):.2f} items/seg
        ========================================
        """)