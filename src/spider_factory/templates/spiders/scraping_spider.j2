"""
Spider generado automáticamente por Spider Factory 2.0
Estrategia: Scraping
Sitio: {{ site_name }}
Fecha: {{ generation_date }}
"""
import scrapy
from scrapy import signals
from scrapy.linkextractors import LinkExtractor
from scrapy.spiders import CrawlSpider, Rule
from datetime import datetime
import re
from urllib.parse import urlparse, urljoin
import logging
from typing import Dict, Any, Optional, List


class {{ spider_class_name }}(CrawlSpider):
    """
    Spider para {{ site_name }}
    
    Utiliza scraping tradicional con reglas de crawling.
    {% if metadata.description %}
    {{ metadata.description }}
    {% endif %}
    """
    name = "{{ spider_name }}"
    allowed_domains = ["{{ domain }}"]
    start_urls = ["{{ base_url }}"]
    
    # Configuración
    custom_settings = {
        'USER_AGENT': 'Mozilla/5.0 (compatible; NewsBot/1.0; +http://example.com/bot)',
        'ROBOTSTXT_OBEY': True,
        'CONCURRENT_REQUESTS': 2,
        'DOWNLOAD_DELAY': 1.5,
        'COOKIES_ENABLED': False,
        'AUTOTHROTTLE_ENABLED': True,
        'AUTOTHROTTLE_TARGET_CONCURRENCY': 2.0,
        'FEEDS': {
            f'output/{{ spider_name }}_%(time)s.json': {
                'format': 'json',
                'encoding': 'utf8',
                'indent': 2
            }
        }
    }
    
    # Reglas de crawling
    rules = (
        {% if url_patterns %}
        # Patrones de URL detectados
        {% for pattern in url_patterns %}
        Rule(
            LinkExtractor(
                allow=r'{{ pattern.regex }}',
                {% if pattern.deny %}deny=r'{{ pattern.deny }}',{% endif %}
                restrict_css='{{ pattern.restrict_css|default("") }}'
            ),
            callback='parse_article',
            follow={{ pattern.follow|default('True') }}
        ),
        {% endfor %}
        {% else %}
        # Reglas genéricas para sitios de noticias
        Rule(
            LinkExtractor(
                allow=(
                    r'/\d{4}/\d{2}/\d{2}/',  # Formato fecha: /2024/03/15/
                    r'/article/',
                    r'/news/',
                    r'/story/',
                ),
                deny=(
                    r'/tag/',
                    r'/category/',
                    r'/author/',
                    r'/search',
                    r'\?',  # Evitar URLs con parámetros
                )
            ),
            callback='parse_article',
            follow=True
        ),
        {% endif %}
        
        # Regla para seguir paginación
        Rule(
            LinkExtractor(
                allow=(r'/page/\d+', r'\?page=\d+'),
                restrict_css='.pagination, .pager, nav[aria-label="pagination"]'
            ),
            follow=True
        ),
    )
    
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.articles_scraped = 0
        self.max_articles = int(kwargs.get('max_articles', 100))
        {% if metadata %}
        # Metadata adicional
        {% for key, value in metadata.items() %}
        self.{{ key }} = "{{ value }}"
        {% endfor %}
        {% endif %}
    
    @classmethod
    def from_crawler(cls, crawler, *args, **kwargs):
        spider = super().from_crawler(crawler, *args, **kwargs)
        crawler.signals.connect(spider.spider_closed, signal=signals.spider_closed)
        return spider
    
    def parse_start_url(self, response):
        """Parsea la página principal"""
        self.logger.info(f"Parseando página principal: {response.url}")
        
        # Extraer enlaces a artículos desde la página principal
        article_links = self.extract_article_links(response)
        
        for link in article_links[:self.max_articles]:
            yield response.follow(link, callback=self.parse_article)
    
    def extract_article_links(self, response) -> List[str]:
        """Extrae enlaces a artículos de una página"""
        links = []
        
        # Selectores comunes para enlaces de artículos
        link_selectors = [
            'article a::attr(href)',
            '.post a::attr(href)',
            '.story a::attr(href)',
            '.headline a::attr(href)',
            'h2 a::attr(href)',
            'h3 a::attr(href)',
        ]
        
        for selector in link_selectors:
            links.extend(response.css(selector).getall())
        
        # Filtrar y validar enlaces
        valid_links = []
        for link in links:
            if self.is_article_url(link):
                valid_links.append(link)
        
        return list(set(valid_links))  # Eliminar duplicados
    
    def is_article_url(self, url: str) -> bool:
        """Determina si una URL corresponde a un artículo"""
        # Patrones que indican que es un artículo
        article_patterns = [
            r'/\d{4}/\d{2}/\d{2}/',  # Fecha en URL
            r'/article/',
            r'/news/',
            r'/story/',
            r'-\d{5,}',  # ID numérico
        ]
        
        # Patrones que indican que NO es un artículo
        non_article_patterns = [
            r'/tag/',
            r'/category/',
            r'/author/',
            r'/search',
            r'/login',
            r'/register',
            r'/contact',
            r'/about',
        ]
        
        # Verificar patrones negativos primero
        for pattern in non_article_patterns:
            if re.search(pattern, url):
                return False
        
        # Verificar patrones positivos
        for pattern in article_patterns:
            if re.search(pattern, url):
                return True
        
        # Si tiene una extensión de archivo que no es .html, probablemente no es un artículo
        parsed = urlparse(url)
        if '.' in parsed.path:
            ext = parsed.path.split('.')[-1].lower()
            if ext not in ['html', 'htm', 'php', 'asp', 'aspx']:
                return False
        
        return True  # Por defecto, asumir que es un artículo
    
    def parse_article(self, response):
        """Parsea una página de artículo"""
        if response.status != 200:
            self.logger.warning(f"Error accediendo artículo: {response.status} - {response.url}")
            return
        
        # Verificar si realmente es un artículo
        if not self.is_article_page(response):
            self.logger.debug(f"No es un artículo: {response.url}")
            return
        
        article_data = {
            'source': '{{ site_name }}',
            'source_url': '{{ base_url }}',
            'article_url': response.url,
            'scraped_at': datetime.now().isoformat(),
            'http_status': response.status
        }
        
        try:
            # Extraer datos usando selectores
            {% if selectors %}
            # Selectores específicos del sitio
            {% if selectors.title %}
            title = response.css('{{ selectors.title }}::text').get()
            if title:
                article_data['title'] = title.strip()
            {% endif %}
            
            {% if selectors.content %}
            content_elements = response.css('{{ selectors.content }}')
            if content_elements:
                # Extraer texto de cada elemento y unir
                content_parts = []
                for elem in content_elements:
                    text = ' '.join(elem.css('::text').getall())
                    if text.strip():
                        content_parts.append(text.strip())
                article_data['content'] = '\n\n'.join(content_parts)
            {% endif %}
            
            {% if selectors.author %}
            author = response.css('{{ selectors.author }}::text').get()
            if author:
                article_data['author'] = author.strip()
            {% endif %}
            
            {% if selectors.date %}
            date = response.css('{{ selectors.date }}::text').get()
            if date:
                article_data['published_date'] = self.parse_date(date.strip())
            {% endif %}
            
            {% if selectors.categories %}
            categories = response.css('{{ selectors.categories }}::text').getall()
            if categories:
                article_data['categories'] = [cat.strip() for cat in categories]
            {% endif %}
            
            {% if selectors.tags %}
            tags = response.css('{{ selectors.tags }}::text').getall()
            if tags:
                article_data['tags'] = [tag.strip() for tag in tags]
            {% endif %}
            
            {% if selectors.image %}
            image = response.css('{{ selectors.image }}::attr(src)').get()
            if image:
                article_data['main_image'] = response.urljoin(image)
            {% endif %}
            {% else %}
            # Extracción genérica si no hay selectores específicos
            article_data.update(self.extract_generic_article(response))
            {% endif %}
            
            # Extraer metadata adicional
            article_data.update(self.extract_metadata(response))
            
            # Validar que tenemos contenido mínimo
            if not article_data.get('title') or not article_data.get('content'):
                self.logger.warning(f"Artículo sin título o contenido: {response.url}")
                return
            
            # Limpiar y normalizar datos
            article_data = self.clean_article_data(article_data)
            
        except Exception as e:
            self.logger.error(f"Error extrayendo contenido de {response.url}: {e}")
            return
        
        self.articles_scraped += 1
        self.logger.info(f"Artículo {self.articles_scraped} extraído: {article_data.get('title', 'Sin título')}")
        
        yield article_data
        
        # Limitar número de artículos
        if self.articles_scraped >= self.max_articles:
            self.logger.info(f"Alcanzado límite de {self.max_articles} artículos")
            self.crawler.engine.close_spider(self, 'max_articles_reached')
    
    def is_article_page(self, response) -> bool:
        """Verifica si la página actual es un artículo"""
        # Verificar por schema.org
        if response.css('script[type="application/ld+json"]').re(r'"@type":\s*"NewsArticle"'):
            return True
        
        # Verificar por meta tags
        if response.css('meta[property="og:type"]::attr(content)').get() == 'article':
            return True
        
        # Verificar por estructura HTML
        article_indicators = [
            'article',
            '[itemtype*="Article"]',
            '.post-content',
            '.article-content',
            '.story-body'
        ]
        
        for indicator in article_indicators:
            if response.css(indicator):
                return True
        
        return False
    
    def extract_generic_article(self, response) -> Dict[str, Any]:
        """Extracción genérica cuando no hay selectores específicos"""
        data = {}
        
        # Título
        title_selectors = [
            'h1::text',
            'meta[property="og:title"]::attr(content)',
            'title::text'
        ]
        for selector in title_selectors:
            title = response.css(selector).get()
            if title:
                data['title'] = title.strip()
                break
        
        # Contenido
        content_selectors = [
            'article p::text',
            '[itemprop="articleBody"] p::text',
            '.post-content p::text',
            '.article-content p::text',
            '.entry-content p::text',
            'main p::text'
        ]
        for selector in content_selectors:
            paragraphs = response.css(selector).getall()
            if paragraphs:
                data['content'] = ' '.join(p.strip() for p in paragraphs if p.strip())
                break
        
        # Autor
        author_selectors = [
            '[rel="author"]::text',
            '[itemprop="author"]::text',
            '.author-name::text',
            '.by-author::text',
            '.article-author::text'
        ]
        for selector in author_selectors:
            author = response.css(selector).get()
            if author:
                data['author'] = author.strip()
                break
        
        # Fecha
        date_selectors = [
            'time::attr(datetime)',
            '[itemprop="datePublished"]::attr(content)',
            '.publish-date::text',
            '.article-date::text'
        ]
        for selector in date_selectors:
            date = response.css(selector).get()
            if date:
                data['published_date'] = self.parse_date(date.strip())
                break
        
        # Imagen principal
        image_selectors = [
            'meta[property="og:image"]::attr(content)',
            '[itemprop="image"]::attr(src)',
            'article img::attr(src)',
            '.featured-image img::attr(src)'
        ]
        for selector in image_selectors:
            image = response.css(selector).get()
            if image:
                data['main_image'] = response.urljoin(image)
                break
        
        return data
    
    def extract_metadata(self, response) -> Dict[str, Any]:
        """Extrae metadata adicional de la página"""
        metadata = {}
        
        # Open Graph
        og_fields = ['title', 'description', 'image', 'type', 'url', 'site_name']
        for field in og_fields:
            value = response.css(f'meta[property="og:{field}"]::attr(content)').get()
            if value:
                metadata[f'og_{field}'] = value
        
        # Twitter Card
        twitter_fields = ['title', 'description', 'image', 'card']
        for field in twitter_fields:
            value = response.css(f'meta[name="twitter:{field}"]::attr(content)').get()
            if value:
                metadata[f'twitter_{field}'] = value
        
        # Otros meta tags útiles
        metadata['meta_description'] = response.css('meta[name="description"]::attr(content)').get()
        metadata['meta_keywords'] = response.css('meta[name="keywords"]::attr(content)').get()
        
        # Schema.org/JSON-LD
        json_ld = response.css('script[type="application/ld+json"]::text').getall()
        if json_ld:
            metadata['structured_data'] = json_ld
        
        return metadata
    
    def parse_date(self, date_string: str) -> Optional[str]:
        """Intenta parsear una fecha a formato ISO"""
        if not date_string:
            return None
        
        # Si ya está en formato ISO, devolverla
        if re.match(r'\d{4}-\d{2}-\d{2}', date_string):
            return date_string
        
        # Intentar parsear formatos comunes
        from dateutil import parser
        try:
            parsed_date = parser.parse(date_string)
            return parsed_date.isoformat()
        except:
            self.logger.warning(f"No se pudo parsear fecha: {date_string}")
            return date_string
    
    def clean_article_data(self, data: Dict[str, Any]) -> Dict[str, Any]:
        """Limpia y normaliza los datos del artículo"""
        # Limpiar espacios en blanco excesivos
        if 'content' in data:
            data['content'] = re.sub(r'\s+', ' ', data['content']).strip()
            # Eliminar contenido muy corto (probablemente no es el artículo real)
            if len(data['content']) < 100:
                self.logger.warning(f"Contenido muy corto ({len(data['content'])} chars)")
        
        if 'title' in data:
            data['title'] = re.sub(r'\s+', ' ', data['title']).strip()
        
        # Eliminar campos vacíos
        return {k: v for k, v in data.items() if v}
    
    def spider_closed(self, spider):
        """Llamado cuando el spider termina"""
        stats = spider.crawler.stats.get_stats()
        
        self.logger.info(f"""
        ========== RESUMEN DE SCRAPING ==========
        Spider: {spider.name}
        Artículos extraídos: {self.articles_scraped}
        Páginas visitadas: {stats.get('downloader/request_count', 0)}
        Duración: {stats.get('elapsed_time_seconds', 0):.2f} segundos
        Velocidad: {stats.get('item_scraped_count', 0) / max(stats.get('elapsed_time_seconds', 1), 1):.2f} items/seg
        ========================================
        """)