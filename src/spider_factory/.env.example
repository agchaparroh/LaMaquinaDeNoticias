# Spider Factory 2.0 - Variables de Entorno

# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8005  # Puerto cambiado para evitar conflictos
API_RELOAD=true

# === Redis Configuration ===
REDIS_HOST=redis  # Usar Redis compartido del sistema
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Si Redis requiere contraseña

# === Firecrawl API ===
FIRECRAWL_API_KEY=your_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
FIRECRAWL_TIMEOUT=30

# === Cache TTL (en segundos) ===
CACHE_TTL_ANALYSIS=86400    # 24 horas
CACHE_TTL_PATTERNS=604800   # 7 días
CACHE_TTL_SPIDERS=2592000   # 30 días

# === Spider Generation ===
SPIDER_OUTPUT_DIR=/app/output_spiders  # Directorio de salida en Docker
SPIDER_TEMPLATE_DIR=/app/templates

# === Limits ===
MAX_URLS_PER_ANALYSIS=10
MAX_BATCH_SIZE=100
SPIDER_FACTORY_MAX_CONCURRENT_ANALYSES=5
SPIDER_FACTORY_ANALYSIS_TIMEOUT=30

# === Logging ===
LOG_LEVEL=INFO
DEBUG_MODE=false