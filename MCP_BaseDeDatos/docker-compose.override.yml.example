# Ejemplo de docker-compose.override.yml para desarrollo local
# Copiar a docker-compose.override.yml y modificar según necesidades

version: '3.8'

services:
  supabase-mcp-server:
    # Para desarrollo: montar código fuente como volumen
    volumes:
      - .:/app
      - mcp-logs:/home/mcpuser/.local/share/supabase-mcp
    
    # Variables de entorno para desarrollo
    environment:
      - SUPABASE_PROJECT_REF=127.0.0.1:54322
      - SUPABASE_DB_PASSWORD=postgres
      - SUPABASE_REGION=us-east-1
      - QUERY_API_KEY=your-dev-api-key
      - PYTHONPATH=/app
    
    # Para debugging
    stdin_open: true
    tty: true
    
    # Comando de desarrollo (opcional)
    # command: python -m supabase_mcp.main
    
    # Dependencias para desarrollo local
    depends_on:
      - supabase-local

  # Activar servicio local de Supabase
  supabase-local:
    profiles: []  # Remover profile para activar siempre