# =============================================================================
# CONFIGURACIÓN DEL PIPELINE DE 7 FASES - EJEMPLO
# =============================================================================
# 
# Copiar este archivo como .env en el directorio raíz del proyecto y 
# ajustar los valores según tu entorno.
#
# Variables marcadas como REQUIRED son obligatorias.
# Variables marcadas como OPTIONAL tienen valores por defecto.
#

# =============================================================================
# VARIABLES CRÍTICAS (REQUIRED)
# =============================================================================

# API Keys obligatorias - REQUERIDAS
GROQ_API_KEY=gsk_tu_api_key_aqui
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key para operaciones avanzadas (opcional)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# CONFIGURACIÓN DEL SERVIDOR FASTAPI (OPTIONAL)
# =============================================================================

# Configuración del servidor
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=false

# Workers y cola
WORKER_COUNT=3
QUEUE_MAX_SIZE=100

# =============================================================================
# CONFIGURACIÓN ESPECÍFICA DEL PIPELINE (OPTIONAL)
# =============================================================================

# --- THRESHOLDS DE CHUNKING ---
# Cuando el contenido excede estos límites se activa chunking automático

# Threshold para número de entidades que activa chunking
PIPELINE_CHUNKING_ENTITIES_THRESHOLD=30

# Threshold para longitud de texto en caracteres que activa chunking  
PIPELINE_CHUNKING_CHARS_THRESHOLD=6000

# Threshold para número de citas que activa chunking
PIPELINE_CHUNKING_QUOTES_THRESHOLD=30

# Threshold para número de datos cuantitativos que activa chunking
PIPELINE_CHUNKING_DATA_THRESHOLD=30

# --- CONFIGURACIÓN DE MODELOS GROQ ---

# Modelo por defecto para fases regulares
PIPELINE_GROQ_MODEL_DEFAULT=llama-3.1-8b-instant

# Modelo grande para contenido complejo (mayor precisión)
PIPELINE_GROQ_MODEL_LARGE=llama-3.1-70b-versatile

# Threshold de tokens que activa uso del modelo grande
PIPELINE_GROQ_MODEL_TOKEN_THRESHOLD=8000

# --- CONFIGURACIÓN DE PROCESAMIENTO ---

# Threshold de similitud para consolidación (0.0-1.0)
# Valores más altos = consolidación más estricta
PIPELINE_CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# Número máximo de reintentos por fase en caso de error
PIPELINE_MAX_RETRIES_PER_PHASE=3

# Habilitar procesamiento paralelo de chunks (true/false)
PIPELINE_CHUNK_PARALLEL_ENABLED=true

# Número máximo de chunks procesados simultáneamente
# Valores muy altos pueden causar rate limiting en la API
PIPELINE_MAX_CONCURRENT_CHUNKS=5

# =============================================================================
# CONFIGURACIÓN DE GROQ API (OPTIONAL)
# =============================================================================

# Modelo por defecto (legacy, usar PIPELINE_GROQ_MODEL_DEFAULT)
MODEL_ID=llama-3.1-8b-instant

# Timeouts y límites
API_TIMEOUT=60
API_TEMPERATURE=0.1
API_MAX_TOKENS=6000
MAX_RETRIES=2
MAX_WAIT_SECONDS=60

# =============================================================================
# LÍMITES DE CONTENIDO (OPTIONAL)
# =============================================================================

# Límites generales de longitud de contenido
MIN_CONTENT_LENGTH=100
MAX_CONTENT_LENGTH=50000

# =============================================================================
# CONFIGURACIÓN DE LOGGING (OPTIONAL)
# =============================================================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logging detallado para desarrollo (true/false)
ENABLE_DETAILED_LOGGING=false

# Notificaciones de logging (true/false)
ENABLE_NOTIFICATIONS=false

# =============================================================================
# CONFIGURACIÓN DE DIRECTORIOS (OPTIONAL)
# =============================================================================

# Directorios para archivos del sistema
PROMPTS_DIR=./prompts
METRICS_DIR=./metrics
LOG_DIR=./logs

# =============================================================================
# CONFIGURACIÓN DE JOB TRACKING (OPTIONAL)
# =============================================================================

# Retención de jobs en memoria (minutos)
JOB_RETENTION_MINUTES=60

# Intervalo de limpieza de jobs (minutos)
JOB_CLEANUP_INTERVAL_MINUTES=5

# Máximo número de jobs almacenados en memoria
JOB_MAX_STORED=10000

# =============================================================================
# CONFIGURACIÓN DE MONITOREO (OPTIONAL)
# =============================================================================

# Habilitar Sentry para monitoreo de errores
SENTRY_ENABLED=false
# SENTRY_DSN=https://tu-dsn@sentry.io/proyecto

# =============================================================================
# CONFIGURACIÓN DE SPACY Y FILTROS (OPTIONAL)
# =============================================================================

# Usar filtro spaCy para análisis avanzado
USE_SPACY_FILTER=true

# Almacenar métricas de rendimiento
STORE_METRICS=true

# =============================================================================
# CONFIGURACIÓN DE MODELO DE IMPORTANCIA (OPTIONAL)
# =============================================================================

# Ruta al modelo de importancia (Fase 4.5)
IMPORTANCE_MODEL_PATH=./models/importance_model.pkl
IMPORTANCE_MODEL_VERSION=1.0
IMPORTANCE_DEFAULT=5

# =============================================================================
# CONFIGURACIÓN DE EMBEDDINGS (OPTIONAL)
# =============================================================================

# Modelo para embeddings semánticos
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS AVANZADA (OPTIONAL)
# =============================================================================

# Pool de conexiones a Supabase
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# CONFIGURACIÓN DE RENDIMIENTO (OPTIONAL)
# =============================================================================

# Batch processing para LLM
LLM_BATCH_SIZE=1
LLM_CONCURRENT_REQUESTS=3

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO (OPTIONAL)
# =============================================================================

# Habilitar endpoints de desarrollo/debug
ENABLE_DEV_ENDPOINTS=false

# =============================================================================
# CONFIGURACIÓN DE ALERTAS (OPTIONAL)
# =============================================================================

# Habilitar sistema de alertas
ENABLE_ALERTS=true
ENABLE_ALERT_NOTIFICATIONS=false

# Umbrales para alertas automáticas
ALERT_ERROR_RATE_THRESHOLD=0.10
ALERT_LATENCY_THRESHOLD_SECONDS=30.0
ALERT_THROTTLE_MINUTES=1
ALERT_RETENTION_HOURS=24

# Directorio para configuración de alertas
ALERT_CONFIG_DIR=.alerts

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. GROQ_API_KEY, SUPABASE_URL y SUPABASE_ANON_KEY son OBLIGATORIAS
#
# 2. Los thresholds de chunking determinan cuándo se activa el procesamiento
#    en paralelo. Valores más bajos = más paralelización pero más llamadas API.
#
# 3. PIPELINE_MAX_CONCURRENT_CHUNKS debe balancearse con los límites de 
#    rate limiting de la API de Groq. El valor por defecto (5) es conservador.
#
# 4. PIPELINE_CONSOLIDATION_SIMILARITY_THRESHOLD controla qué tan agresiva
#    es la eliminación de duplicados. 0.85 es un buen balance.
#
# 5. Para entornos de producción, establecer DEBUG_MODE=false y 
#    LOG_LEVEL=WARNING o ERROR.
#
# 6. El modelo grande (llama-3.1-70b-versatile) es más preciso pero más 
#    lento y costoso. Se usa automáticamente para contenido complejo.
#