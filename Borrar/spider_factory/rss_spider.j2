{% extends "base_spider.j2" %}

{% block parse_method %}
    def parse(self, response):
        """
        Parsea el feed RSS y extrae URLs de artículos
        """
        try:
            # Verificar que es un feed RSS/XML
            content_type = response.headers.get('Content-Type', b'').decode('utf-8').lower()
            
            if 'xml' not in content_type and 'rss' not in content_type:
                self.logger.warning(f"Tipo de contenido inesperado: {content_type}")
                # Intentar buscar feeds alternativos
                yield from self.find_alternative_feeds(response)
                return
            
            # Parsear el feed con feedparser
            feed = feedparser.parse(response.text)
            
            if not feed.entries:
                self.logger.warning("No se encontraron entradas en el feed RSS")
                return
            
            self.logger.info(f"Encontradas {len(feed.entries)} entradas en el feed")
            
            # Procesar cada entrada del feed
            for entry in feed.entries:
                # Verificar límite de artículos
                if self.articles_scraped >= self.max_articles:
                    self.logger.info(f"Alcanzado límite de {self.max_articles} artículos")
                    raise CloseSpider('article_limit_reached')
                
                # Extraer URL del artículo
                article_url = entry.get('link', '')
                
                if not article_url or not self.should_follow_url(article_url):
                    continue
                
                # Preparar metadata desde el feed
                feed_data = {
                    'feed_title': entry.get('title', ''),
                    'feed_summary': entry.get('summary', ''),
                    'feed_published': entry.get('published', ''),
                    'feed_author': entry.get('author', ''),
                    'feed_categories': [tag.term for tag in entry.get('tags', [])]
                }
                
                # Solicitar el artículo completo
                yield scrapy.Request(
                    url=article_url,
                    callback=self.parse_article,
                    meta={'feed_data': feed_data},
                    errback=self.errback_httpbin
                )
            
            # Buscar siguiente página del feed si existe
            {% if follow_pagination %}
            yield from self.follow_feed_pagination(feed, response)
            {% endif %}
            
        except Exception as e:
            self.logger.error(f"Error parseando feed RSS: {e}")
    
    def parse_article(self, response):
        """
        Parsea un artículo individual desde el feed RSS
        """
        feed_data = response.meta.get('feed_data', {})
        
        # Crear item con datos del feed como fallback
        item = self.create_item(
            titular=feed_data.get('feed_title', ''),
            resumen=feed_data.get('feed_summary', ''),
            medio_url_principal=response.url
        )
        
        # Extraer datos del artículo usando selectores si están disponibles
        {% if selectors %}
        try:
            {% if has_selector('title') %}
            # Título
            title = response.css('{{ selectors.title }}::text').get()
            if title:
                item['titular'] = title.strip()
            {% endif %}
            
            {% if has_selector('content') %}
            # Contenido
            content_parts = response.css('{{ selectors.content }} ::text').getall()
            if content_parts:
                item['contenido'] = ' '.join(content_parts).strip()
            {% endif %}
            
            {% if has_selector('date') %}
            # Fecha de publicación
            date_text = response.css('{{ selectors.date }}::text').get()
            if not date_text:
                date_text = response.css('{{ selectors.date }}::attr(datetime)').get()
            if date_text:
                item['fecha_publicacion'] = self.parse_date(date_text)
            {% endif %}
            
            {% if has_selector('author') %}
            # Autor
            author = response.css('{{ selectors.author }}::text').get()
            if author:
                item['autor'] = author.strip()
            {% endif %}
            
            {% if has_selector('image') %}
            # Imagen principal
            image_url = response.css('{{ selectors.image }}::attr(src)').get()
            if not image_url:
                image_url = response.css('{{ selectors.image }}::attr(data-src)').get()
            if image_url:
                item['url_imagen_principal'] = response.urljoin(image_url)
            {% endif %}
            
            {% if has_selector('tags') %}
            # Etiquetas
            tags = response.css('{{ selectors.tags }}::text').getall()
            if tags:
                item['etiquetas'] = [tag.strip() for tag in tags if tag.strip()]
            {% endif %}
            
        except Exception as e:
            self.logger.warning(f"Error extrayendo con selectores: {e}")
        {% else %}
        # Sin selectores específicos, intentar extracción genérica
        self.extract_generic_article_data(response, item)
        {% endif %}
        
        # Usar datos del feed si no se encontraron en la página
        if not item.get('fecha_publicacion') and feed_data.get('feed_published'):
            item['fecha_publicacion'] = self.parse_date(feed_data['feed_published'])
        
        if not item.get('autor') and feed_data.get('feed_author'):
            item['autor'] = feed_data['feed_author']
        
        if not item.get('etiquetas') and feed_data.get('feed_categories'):
            item['etiquetas'] = feed_data['feed_categories']
        
        # Agregar metadata
        item['seccion'] = self.extract_section_from_url(response.url)
        item['tipo_contenido'] = 'articulo'
        item['idioma'] = 'es'
        {% if area_geografica is defined %}
        item['ubicacion_geografica'] = '{{ area_geografica }}'
        {% endif %}
        
        # Validar campos obligatorios
        if not item.get('titular'):
            self.logger.warning(f"Artículo sin título: {response.url}")
            return
        
        self.articles_scraped += 1
        yield item
    
    def find_alternative_feeds(self, response):
        """
        Busca feeds RSS alternativos en la página
        """
        # Buscar enlaces a feeds en el HTML
        feed_links = response.css('link[type*="rss"]::attr(href)').getall()
        feed_links.extend(response.css('link[type*="xml"]::attr(href)').getall())
        feed_links.extend(response.css('a[href*="feed"]::attr(href)').getall())
        feed_links.extend(response.css('a[href*="rss"]::attr(href)').getall())
        
        seen = set()
        for link in feed_links:
            full_url = response.urljoin(link)
            if full_url not in seen:
                seen.add(full_url)
                self.logger.info(f"Feed alternativo encontrado: {full_url}")
                yield scrapy.Request(
                    url=full_url,
                    callback=self.parse,
                    dont_filter=True,
                    priority=1
                )
    
    {% if follow_pagination %}
    def follow_feed_pagination(self, feed, response):
        """
        Busca y sigue paginación del feed RSS
        """
        # Buscar enlaces de paginación en el feed
        for link in feed.feed.get('links', []):
            if link.get('rel') == 'next':
                next_url = link.get('href')
                if next_url:
                    yield scrapy.Request(
                        url=response.urljoin(next_url),
                        callback=self.parse,
                        priority=0
                    )
                    return
        
        # Buscar en la página HTML si no está en el feed
        next_links = response.css('a[rel="next"]::attr(href)').getall()
        next_links.extend(response.css('a:contains("Siguiente")::attr(href)').getall())
        next_links.extend(response.css('a:contains("Next")::attr(href)').getall())
        
        for link in next_links:
            if 'feed' in link or 'rss' in link:
                yield scrapy.Request(
                    url=response.urljoin(link),
                    callback=self.parse,
                    priority=0
                )
                break
    {% endif %}
    
    def extract_generic_article_data(self, response, item):
        """
        Intenta extraer datos del artículo usando patrones comunes
        """
        # Título - buscar en meta tags primero
        if not item.get('titular'):
            title = response.css('meta[property="og:title"]::attr(content)').get()
            if not title:
                title = response.css('title::text').get()
            if not title:
                title = response.css('h1::text').get()
            if title:
                item['titular'] = title.strip()
        
        # Contenido - buscar en áreas comunes
        if not item.get('contenido'):
            content_selectors = [
                'article',
                '[class*="content"]',
                '[class*="article"]',
                '[class*="post"]',
                'main',
                '.entry-content'
            ]
            
            for selector in content_selectors:
                content_parts = response.css(f'{selector} p::text').getall()
                if len(content_parts) > 2:  # Al menos algunos párrafos
                    item['contenido'] = ' '.join(content_parts).strip()
                    break
        
        # Imagen - buscar en meta tags
        if not item.get('url_imagen_principal'):
            image_url = response.css('meta[property="og:image"]::attr(content)').get()
            if image_url:
                item['url_imagen_principal'] = response.urljoin(image_url)
        
        # Fecha - buscar en meta tags y elementos time
        if not item.get('fecha_publicacion'):
            date_text = response.css('meta[property="article:published_time"]::attr(content)').get()
            if not date_text:
                date_text = response.css('time::attr(datetime)').get()
            if not date_text:
                date_text = response.css('time::text').get()
            if date_text:
                item['fecha_publicacion'] = self.parse_date(date_text)
        
        # Autor - buscar en meta tags y patrones comunes
        if not item.get('autor'):
            author = response.css('meta[name="author"]::attr(content)').get()
            if not author:
                author = response.css('[class*="author"] ::text').get()
            if not author:
                author = response.css('[rel="author"]::text').get()
            if author:
                item['autor'] = author.strip()
    
    def parse_date(self, date_string):
        """
        Intenta parsear una fecha en varios formatos
        """
        if not date_string:
            return None
        
        # Formatos comunes de fecha
        date_formats = [
            '%Y-%m-%dT%H:%M:%S%z',
            '%Y-%m-%dT%H:%M:%SZ',
            '%Y-%m-%d %H:%M:%S',
            '%Y-%m-%d',
            '%d/%m/%Y',
            '%d-%m-%Y',
            '%B %d, %Y',
            '%d %B %Y',
            '%a, %d %b %Y %H:%M:%S %z'
        ]
        
        for fmt in date_formats:
            try:
                parsed_date = datetime.strptime(date_string.strip(), fmt)
                return parsed_date.isoformat()
            except ValueError:
                continue
        
        # Si no se pudo parsear, devolver la cadena original
        self.logger.debug(f"No se pudo parsear fecha: {date_string}")
        return date_string
    
    def extract_section_from_url(self, url):
        """
        Intenta extraer la sección desde la URL
        """
        from urllib.parse import urlparse
        
        path = urlparse(url).path
        parts = [p for p in path.split('/') if p]
        
        # Buscar palabras clave de secciones
        section_keywords = [
            'politica', 'economia', 'deportes', 'cultura', 
            'tecnologia', 'ciencia', 'salud', 'educacion',
            'internacional', 'nacional', 'local', 'opinion',
            'espectaculos', 'sociedad'
        ]
        
        for part in parts:
            part_lower = part.lower()
            for keyword in section_keywords:
                if keyword in part_lower:
                    return keyword
        
        # Si no se encuentra, usar el primer segmento significativo
        if parts:
            return parts[0]
        
        return 'general'
    
    def errback_httpbin(self, failure):
        """
        Maneja errores de requests
        """
        self.logger.error(f'Error en request: {failure.value}')
{% endblock %}

{% block additional_methods %}
    # El spider RSS ya incluye todos los métodos necesarios en parse_method
{% endblock %}