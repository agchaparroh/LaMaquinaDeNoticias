{% extends "base_spider.j2" %}

{% block parse_method %}
    def parse(self, response):
        """
        Método principal - detecta si es página de listado o artículo
        """
        # Verificar si es un artículo directamente
        if self._is_article_page(response):
            yield from self.parse_article(response)
            return
        
        # Es una página de listado - extraer enlaces a artículos
        self.logger.info(f"Procesando página de listado: {response.url}")
        
        # Extraer enlaces usando selectores o detección automática
        article_links = self._extract_article_links(response)
        
        self.logger.info(f"Encontrados {len(article_links)} enlaces a artículos")
        
        for link in article_links:
            # Verificar límite
            if self.articles_scraped >= self.max_articles:
                self.logger.info(f"Alcanzado límite de {self.max_articles} artículos")
                raise CloseSpider('article_limit_reached')
            
            # Verificar si debe seguirse
            if not self.should_follow_url(link):
                continue
            
            yield scrapy.Request(
                url=response.urljoin(link),
                callback=self.parse_article,
                meta={
                    'section': self._extract_section_from_url(link),
                    'listing_url': response.url
                }
            )
        
        {% if follow_pagination %}
        # Buscar y seguir paginación
        yield from self._follow_pagination(response)
        {% endif %}
    
    def parse_article(self, response):
        """
        Parsea una página de artículo individual
        """
        # Crear item base
        item = self.create_item(
            medio_url_principal=response.url,
            seccion=response.meta.get('section', 'general')
        )
        
        {% if selectors %}
        # Usar selectores específicos proporcionados
        try:
            {% if has_selector('title') %}
            # Título
            title = response.css('{{ selectors.title }}::text').get()
            if not title:
                # Intentar con xpath si CSS falla
                title = response.xpath('{{ selectors.title }}/text()').get()
            if title:
                item['titular'] = title.strip()
            {% endif %}
            
            {% if has_selector('content') %}
            # Contenido
            content_elements = response.css('{{ selectors.content }}')
            if content_elements:
                # Extraer texto de todos los elementos hijos
                content_parts = []
                for elem in content_elements:
                    text_parts = elem.css('::text').getall()
                    content_parts.extend(text_parts)
                
                content = ' '.join(content_parts).strip()
                # Limpiar espacios múltiples
                content = ' '.join(content.split())
                
                if content:
                    item['contenido'] = content
            {% endif %}
            
            {% if has_selector('date') %}
            # Fecha de publicación
            date_elem = response.css('{{ selectors.date }}')
            date_text = date_elem.css('::text').get()
            if not date_text:
                # Intentar atributos comunes
                date_text = date_elem.css('::attr(datetime)').get()
                if not date_text:
                    date_text = date_elem.css('::attr(content)').get()
            
            if date_text:
                item['fecha_publicacion'] = self._parse_date(date_text.strip())
            {% endif %}
            
            {% if has_selector('author') %}
            # Autor
            author_text = response.css('{{ selectors.author }}::text').get()
            if not author_text:
                # Intentar con el atributo content de meta
                author_text = response.css('{{ selectors.author }}::attr(content)').get()
            
            if author_text:
                # Limpiar prefijos comunes
                author_text = author_text.strip()
                for prefix in ['Por ', 'By ', 'Autor: ', 'Author: ']:
                    if author_text.startswith(prefix):
                        author_text = author_text[len(prefix):]
                        break
                
                item['autor'] = author_text.strip()
            {% endif %}
            
            {% if has_selector('image') %}
            # Imagen principal
            image_elem = response.css('{{ selectors.image }}')
            image_url = image_elem.css('::attr(src)').get()
            if not image_url:
                # Intentar data-src (lazy loading)
                image_url = image_elem.css('::attr(data-src)').get()
            if not image_url:
                # Si el selector apunta a un meta tag
                image_url = image_elem.css('::attr(content)').get()
            
            if image_url:
                item['url_imagen_principal'] = response.urljoin(image_url)
            {% endif %}
            
            {% if has_selector('tags') %}
            # Etiquetas/Tags
            tags = response.css('{{ selectors.tags }}::text').getall()
            if tags:
                # Limpiar y filtrar tags vacíos
                tags = [tag.strip() for tag in tags if tag.strip()]
                # Eliminar duplicados manteniendo orden
                seen = set()
                unique_tags = []
                for tag in tags:
                    if tag.lower() not in seen:
                        seen.add(tag.lower())
                        unique_tags.append(tag)
                
                if unique_tags:
                    item['etiquetas'] = unique_tags
            {% endif %}
            
            {% if has_selector('summary') %}
            # Resumen
            summary = response.css('{{ selectors.summary }}::text').get()
            if summary:
                item['resumen'] = summary.strip()
            {% endif %}
            
        except Exception as e:
            self.logger.error(f"Error usando selectores específicos: {e}")
            # Continuar con extracción genérica
        {% endif %}
        
        # Extracción genérica para campos faltantes
        self._extract_with_patterns(response, item)
        
        # Extraer metadata adicional
        self._extract_metadata(response, item)
        
        # Validación final
        if not item.get('titular'):
            self.logger.warning(f"Artículo sin título: {response.url}")
            return
        
        # Establecer valores por defecto
        item['tipo_contenido'] = 'articulo'
        item['idioma'] = item.get('idioma', 'es')
        {% if area_geografica is defined %}
        item['ubicacion_geografica'] = '{{ area_geografica }}'
        {% endif %}
        
        self.articles_scraped += 1
        yield item
    
    def _is_article_page(self, response):
        """
        Determina si la página actual es un artículo
        """
        # Verificar por URL patterns comunes de artículos
        url_patterns = [
            r'/\d{4}/\d{2}/\d{2}/',  # Fecha en URL
            r'/article/',
            r'/noticia/',
            r'/news/',
            r'/post/',
            r'/\d+\.html?$',  # ID numérico.html
            r'/[a-z0-9\-]+\.html?$'  # slug.html
        ]
        
        import re
        for pattern in url_patterns:
            if re.search(pattern, response.url, re.IGNORECASE):
                return True
        
        # Verificar por estructura de contenido
        # Un artículo típicamente tiene:
        has_title = bool(response.css('h1').get())
        has_paragraphs = len(response.css('p').getall()) > 3
        has_article_tag = bool(response.css('article').get())
        has_meta_article = bool(response.css('meta[property*="article"]').get())
        
        indicators = sum([has_title, has_paragraphs, has_article_tag, has_meta_article])
        
        return indicators >= 2
    
    def _is_section_article(self, url, response=None):
        """
        Determina si una URL pertenece a la sección objetivo
        """
        # Extraer sección de la URL
        section = self._extract_section_from_url(url)
        
        # Si no hay sección específica configurada, aceptar todo
        {% if section_name is defined %}
        target_section = '{{ section_name }}'.lower()
        if target_section and section.lower() != target_section:
            return False
        {% endif %}
        
        # Verificar que no sea una URL excluida
        excluded_sections = ['tags', 'author', 'category', 'archivo', 'buscar', 'search']
        for excluded in excluded_sections:
            if excluded in url.lower():
                return False
        
        return True
    
    def _extract_article_links(self, response):
        """
        Extrae enlaces a artículos de una página de listado
        """
        links = set()
        
        {% if has_selector('links') %}
        # Usar selector de enlaces específico
        specific_links = response.css('{{ selectors.links }}::attr(href)').getall()
        links.update(specific_links)
        {% endif %}
        
        # Patrones comunes para encontrar enlaces de artículos
        link_selectors = [
            'article a::attr(href)',
            'h2 a::attr(href)',
            'h3 a::attr(href)',
            '.post a::attr(href)',
            '.entry a::attr(href)',
            '.item a::attr(href)',
            'a.permalink::attr(href)',
            'a[rel="bookmark"]::attr(href)'
        ]
        
        for selector in link_selectors:
            found_links = response.css(selector).getall()
            links.update(found_links)
        
        # Filtrar enlaces válidos
        valid_links = []
        for link in links:
            full_url = response.urljoin(link)
            
            # Verificar que es un enlace válido de artículo
            if self._is_section_article(full_url):
                valid_links.append(link)
        
        return valid_links
    
    {% if follow_pagination %}
    def _follow_pagination(self, response):
        """
        Busca y sigue enlaces de paginación
        """
        # Selectores comunes de paginación
        pagination_selectors = [
            'a[rel="next"]::attr(href)',
            'a.next::attr(href)',
            '.pagination a::attr(href)',
            'a:contains("Siguiente")::attr(href)',
            'a:contains("Next")::attr(href)',
            'a:contains("→")::attr(href)',
            'a[aria-label*="siguiente"]::attr(href)',
            'a[aria-label*="next"]::attr(href)'
        ]
        
        for selector in pagination_selectors:
            next_page = response.css(selector).get()
            if next_page:
                next_url = response.urljoin(next_page)
                
                # Verificar que no hemos visitado demasiadas páginas
                page_number = response.meta.get('page_number', 1)
                if page_number < {{ max_pages }}:
                    yield scrapy.Request(
                        url=next_url,
                        callback=self.parse,
                        meta={'page_number': page_number + 1}
                    )
                    return
                else:
                    self.logger.info(f"Alcanzado límite de {page_number} páginas")
                    return
        
        # Intentar con patrones numéricos en URL
        import re
        url = response.url
        
        # Buscar patrones como /page/2/, ?page=2, etc.
        patterns = [
            (r'/page/(\d+)', '/page/{}'),
            (r'[?&]page=(\d+)', lambda n: url.split('?')[0] + f'?page={n}'),
            (r'/p/(\d+)', '/p/{}'),
            (r'[?&]p=(\d+)', lambda n: url.split('?')[0] + f'?p={n}')
        ]
        
        for pattern, replacement in patterns:
            match = re.search(pattern, url)
            if match:
                current_page = int(match.group(1))
                next_page = current_page + 1
                
                if next_page <= {{ max_pages }}:
                    if callable(replacement):
                        next_url = replacement(next_page)
                    else:
                        next_url = re.sub(pattern, replacement.format(next_page), url)
                    
                    yield scrapy.Request(
                        url=next_url,
                        callback=self.parse,
                        meta={'page_number': next_page}
                    )
                return
    {% endif %}
    
    def _extract_with_patterns(self, response, item):
        """
        Extrae datos usando patrones comunes cuando no hay selectores específicos
        """
        # Título
        if not item.get('titular'):
            title_selectors = [
                'meta[property="og:title"]::attr(content)',
                'meta[name="twitter:title"]::attr(content)',
                'h1::text',
                'title::text',
                '.entry-title::text',
                '.post-title::text'
            ]
            
            for selector in title_selectors:
                title = response.css(selector).get()
                if title:
                    item['titular'] = title.strip()
                    break
        
        # Contenido
        if not item.get('contenido'):
            content_selectors = [
                'article',
                '[itemprop="articleBody"]',
                '.entry-content',
                '.post-content',
                '.article-content',
                '.content',
                'main'
            ]
            
            for selector in content_selectors:
                content_elem = response.css(selector).get()
                if content_elem:
                    # Extraer solo párrafos para evitar ruido
                    paragraphs = response.css(f'{selector} p::text').getall()
                    if len(paragraphs) > 2:
                        content = ' '.join(paragraphs)
                        content = ' '.join(content.split())  # Limpiar espacios
                        if len(content) > 100:  # Contenido significativo
                            item['contenido'] = content
                            break
        
        # Fecha
        if not item.get('fecha_publicacion'):
            date_selectors = [
                'meta[property="article:published_time"]::attr(content)',
                'meta[name="publish_date"]::attr(content)',
                'time::attr(datetime)',
                'time::text',
                '[itemprop="datePublished"]::attr(content)',
                '[itemprop="datePublished"]::text',
                '.date::text',
                '.published::text'
            ]
            
            for selector in date_selectors:
                date_text = response.css(selector).get()
                if date_text:
                    parsed_date = self._parse_date(date_text.strip())
                    if parsed_date:
                        item['fecha_publicacion'] = parsed_date
                        break
        
        # Autor
        if not item.get('autor'):
            author_selectors = [
                'meta[name="author"]::attr(content)',
                'meta[property="article:author"]::attr(content)',
                '[itemprop="author"]::text',
                '[rel="author"]::text',
                '.author::text',
                '.by-author::text',
                '.byline::text'
            ]
            
            for selector in author_selectors:
                author = response.css(selector).get()
                if author:
                    author = author.strip()
                    # Limpiar prefijos comunes
                    for prefix in ['Por ', 'By ', 'Escrito por ']:
                        if author.startswith(prefix):
                            author = author[len(prefix):]
                    item['autor'] = author.strip()
                    break
        
        # Imagen
        if not item.get('url_imagen_principal'):
            image_selectors = [
                'meta[property="og:image"]::attr(content)',
                'meta[name="twitter:image"]::attr(content)',
                'article img::attr(src)',
                '.featured-image img::attr(src)',
                '.post-thumbnail img::attr(src)',
                'figure img::attr(src)'
            ]
            
            for selector in image_selectors:
                image_url = response.css(selector).get()
                if image_url:
                    item['url_imagen_principal'] = response.urljoin(image_url)
                    break
    
    def _extract_metadata(self, response, item):
        """
        Extrae metadata adicional de la página
        """
        metadata = {}
        
        # Keywords desde meta
        keywords = response.css('meta[name="keywords"]::attr(content)').get()
        if keywords:
            item['palabras_clave'] = [k.strip() for k in keywords.split(',') if k.strip()]
        
        # Descripción como resumen si no existe
        if not item.get('resumen'):
            description = response.css('meta[name="description"]::attr(content)').get()
            if not description:
                description = response.css('meta[property="og:description"]::attr(content)').get()
            if description:
                item['resumen'] = description.strip()
        
        # Categoría desde breadcrumbs o meta
        if not item.get('categoria'):
            # Intentar breadcrumbs
            breadcrumbs = response.css('[itemtype*="BreadcrumbList"] [itemprop="name"]::text').getall()
            if len(breadcrumbs) > 1:
                item['categoria'] = breadcrumbs[1]  # Típicamente el segundo es la categoría
            else:
                # Intentar desde meta
                category = response.css('meta[property="article:section"]::attr(content)').get()
                if category:
                    item['categoria'] = category
        
        # Detectar idioma
        lang = response.css('html::attr(lang)').get()
        if lang:
            item['idioma'] = lang.split('-')[0]  # es-ES -> es
        
        # Multimedia adicional
        multimedia = []
        
        # Videos
        videos = response.css('video source::attr(src)').getall()
        videos.extend(response.css('iframe[src*="youtube"]::attr(src)').getall())
        videos.extend(response.css('iframe[src*="vimeo"]::attr(src)').getall())
        
        for video_url in videos:
            multimedia.append({
                'tipo': 'video',
                'url': response.urljoin(video_url)
            })
        
        # Imágenes adicionales en el contenido
        content_images = response.css('article img::attr(src)').getall()
        for img_url in content_images[:5]:  # Limitar a 5 imágenes
            if img_url != item.get('url_imagen_principal'):
                multimedia.append({
                    'tipo': 'imagen',
                    'url': response.urljoin(img_url)
                })
        
        if multimedia:
            item['multimedia'] = multimedia
        
        # Enlaces relacionados
        related_links = []
        related_selectors = [
            '.related a',
            '.see-also a',
            'aside a',
            '[class*="related"] a'
        ]
        
        for selector in related_selectors:
            links = response.css(f'{selector}::attr(href)').getall()
            titles = response.css(f'{selector}::text').getall()
            
            for link, title in zip(links[:5], titles[:5]):  # Limitar a 5
                if link and title:
                    related_links.append({
                        'url': response.urljoin(link),
                        'titulo': title.strip()
                    })
            
            if related_links:
                break
        
        if related_links:
            item['enlaces_relacionados'] = related_links
        
        # Guardar metadata adicional
        if any([
            response.meta.get('listing_url'),
            breadcrumbs,
            response.css('[itemtype*="NewsArticle"]').get()
        ]):
            metadata['listing_url'] = response.meta.get('listing_url')
            metadata['has_structured_data'] = bool(response.css('[itemtype*="Article"]').get())
            metadata['breadcrumbs'] = breadcrumbs if 'breadcrumbs' in locals() else []
            
            item['metadata_adicional'] = metadata
    
    def _parse_date(self, date_string):
        """
        Parsea fechas en múltiples formatos
        """
        if not date_string:
            return None
        
        from datetime import datetime
        import locale
        
        # Intentar establecer locale español
        try:
            locale.setlocale(locale.LC_TIME, 'es_ES.UTF-8')
        except:
            pass
        
        # Limpiar string
        date_string = date_string.strip()
        date_string = date_string.replace('  ', ' ')
        
        # Formatos comunes
        formats = [
            '%Y-%m-%dT%H:%M:%S%z',
            '%Y-%m-%dT%H:%M:%SZ',
            '%Y-%m-%d %H:%M:%S',
            '%Y-%m-%d %H:%M',
            '%Y-%m-%d',
            '%d/%m/%Y %H:%M',
            '%d/%m/%Y',
            '%d-%m-%Y',
            '%d de %B de %Y',
            '%d %B %Y',
            '%B %d, %Y',
            '%d %b %Y',
            '%Y%m%d'
        ]
        
        for fmt in formats:
            try:
                parsed = datetime.strptime(date_string, fmt)
                return parsed.isoformat()
            except ValueError:
                continue
        
        # Intentar con dateutil si está disponible
        try:
            from dateutil import parser
            parsed = parser.parse(date_string)
            return parsed.isoformat()
        except:
            pass
        
        self.logger.debug(f"No se pudo parsear fecha: {date_string}")
        return date_string
    
    def _extract_section_from_url(self, url):
        """
        Extrae la sección desde la URL
        """
        from urllib.parse import urlparse
        
        path = urlparse(url).path.lower()
        segments = [s for s in path.split('/') if s]
        
        # Palabras clave de secciones comunes
        section_keywords = {
            'politica': ['politica', 'politics', 'gobierno'],
            'economia': ['economia', 'economy', 'finanzas', 'mercados'],
            'deportes': ['deportes', 'sports', 'futbol', 'football'],
            'cultura': ['cultura', 'culture', 'arte', 'libros'],
            'tecnologia': ['tecnologia', 'tech', 'technology', 'ciencia'],
            'internacional': ['internacional', 'mundo', 'world', 'global'],
            'sociedad': ['sociedad', 'society', 'social'],
            'salud': ['salud', 'health', 'medicina'],
            'educacion': ['educacion', 'education'],
            'opinion': ['opinion', 'editorial', 'columna'],
            'espectaculos': ['espectaculos', 'farandula', 'celebrities']
        }
        
        # Buscar en segmentos de URL
        for segment in segments:
            for section, keywords in section_keywords.items():
                if any(keyword in segment for keyword in keywords):
                    return section
        
        # Si no se encuentra, usar primer segmento significativo
        for segment in segments:
            if segment and not segment.isdigit() and len(segment) > 2:
                return segment
        
        return 'general'
{% endblock %}

{% block additional_methods %}
    # Los métodos adicionales ya están incluidos en el bloque parse_method
{% endblock %}